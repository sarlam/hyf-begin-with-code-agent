{
  "name": "ai-agent-first-base",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:slides && npm run build:workbook && npm run build:home",
    "build:slides": "slidev build --base ./ --out dist/slides",
    "build:workbook": "tsc -p workbook && vite build workbook",
    "build:home": "vite build home --base ./ --outDir ../dist",
    "dev": "slidev --open",
    "dev:workbook": "vite workbook --open",
    "test:workbook": "node --test \"workbook/src/**/*.test.ts\"",
    "export": "slidev export",
    "dev:variants": "slidev variants.md --open"
  },
  "dependencies": {
    "@slidev/cli": "^53.1.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
